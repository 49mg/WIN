# Copy to .env and fill in. Never commit .env.
# Free keys. TMDB: https://www.themoviedb.org/settings/api
# IGDB: register an app at https://dev.twitch.tv/console (redirect URL http://localhost)
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: LLM re-ranking + explanations (Claude Haiku 5.5). Without it WIN uses its own engine.
# https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Production only (docker-compose.prod.yml)
POSTGRES_PASSWORD=
WIN_DOMAIN=win.code-cubes.com
